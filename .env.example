# Discord Bot Authentication Secret
DISCORD_TOKEN=your_bot_token_here

# Path to the dedicated Discord IDs configuration file (defaults to config/discord_ids.json)
# All Discord IDs (Guild ID, Role IDs, Channel IDs) are managed in config/discord_ids.json
DISCORD_IDS_FILE=config/discord_ids.json

# Optional: Emoji that triggers the RED safeword when reacted with (defaults to 🛑)
SAFEWORD_EMOJI=🛑

# PostgreSQL Configuration (Used by docker-compose.yml)
DB_USER=syn_admin
DB_PASSWORD=generate_a_64_char_random_password_here
DB_HOST=postgres
DB_PORT=5432
DB_NAME=syn_prod
DB_SSLMODE=disable

# Logging Suite & File Rotation Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=/app/logs/syn.log
LOG_MAX_SIZE_MB=10
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=30
LOGS_HOST_DIR=./logs

# Assets Configuration
# ASSETS_HOST_DIR: Path on the host machine mounted into Docker (defaults to ./assets/panels)
ASSETS_HOST_DIR=./assets/panels
# ASSETS_DIR: In-container path where the bot reads images
ASSETS_DIR=/app/assets/panels

# Web Server & Legal Pages Configuration
# WEB_PORT: Port exposed on the EC2 host for the Terms & Privacy web server (defaults to 8080)
WEB_PORT=8080
# WEB_BASE_URL: Public URL where external users reach the web server (used by /terms and /privacy commands)
# Example: http://<YOUR_EC2_PUBLIC_IP>:8080 or https://syn.yourdomain.com
WEB_BASE_URL=http://localhost:8080
