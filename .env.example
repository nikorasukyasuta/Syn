# ==============================================================================
# Syn Production Environment Secrets (.env)
#
# ONLY secrets and host-specific connection endpoints belong in this file.
# All Discord IDs, role mappings, channel IDs, and non-secret runtime settings
# are managed via config/discord_ids.json and built-in production defaults.
# ==============================================================================

# 1. Discord Bot Authentication Secret
DISCORD_TOKEN=your_bot_token_here

# 2. PostgreSQL Credentials (Used by docker-compose.yml and the Bot)
DB_USER=syn_admin
DB_PASSWORD=generate_a_64_char_random_password_here
DB_HOST=postgres
DB_PORT=5432
DB_NAME=syn_prod

# 3. Public Host URL for Web Terms & Privacy Links (Replace localhost with your EC2 IP or domain)
WEB_BASE_URL=http://localhost:8080
