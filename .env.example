# Discord Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=123456789012345678
DISCORD_VERIFIED_ROLE_ID=987654321098765432
DISCORD_UNVERIFIED_ROLE_ID=112233445566778899

# Comma-separated Role IDs for Staff and Server Helpers
ALLOWED_VERIFIER_ROLE_IDS=111111111111111111,222222222222222222

# Optional: Dedicated Channel ID for Staff Alerts (e.g. Safeword / RED alerts)
# If omitted, staff pings are sent directly in the channel where RED is triggered.
STAFF_ALERT_CHANNEL_ID=
# Optional: Emoji that triggers the RED safeword when reacted with (defaults to 🛑)
SAFEWORD_EMOJI=🛑

# PostgreSQL Configuration (Used by docker-compose.yml)
DB_USER=syn_admin
DB_PASSWORD=generate_a_64_char_random_password_here
DB_HOST=postgres
DB_PORT=5432
DB_NAME=syn_prod
DB_SSLMODE=disable

# Logging Suite & File Rotation Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=/app/logs/syn.log
LOG_MAX_SIZE_MB=10
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=30
LOGS_HOST_DIR=./logs

# Assets Configuration
# ASSETS_HOST_DIR: Path on the host machine mounted into Docker (defaults to ./assets/panels)
ASSETS_HOST_DIR=./assets/panels
# ASSETS_DIR: In-container path where the bot reads images
ASSETS_DIR=/app/assets/panels